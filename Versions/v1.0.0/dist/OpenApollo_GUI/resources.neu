for attempt in range(10): 
    try:
        ser = serial.Serial(
            port=SerConfig['InputComPort'],
            baudrate=SerConfig['InputBaudRate'],
            parity=serial.PARITY_ODD,
            stopbits=serial.STOPBITS_TWO,
            bytesize=serial.SEVENBITS
        )
