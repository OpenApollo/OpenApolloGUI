        <script type="module" src="StartSampling.js"></script>
        <button id="ARMNOSERVO">ARM+NS</button>
        <script type="module" src="StartSampling.js"></script>
        <button id="DISARM">DISARM</button>   
        <script type="module" src="StartSampling.js"></script>
